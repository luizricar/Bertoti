// Antipattern - Tudo misturado em uma única classe
class CalculadoraAntipattern {

    public int executarOperacao(String operacao, int a, int b) {
        if ("soma".equalsIgnoreCase(operacao)) {
            return a + b;
        } else if ("subtracao".equalsIgnoreCase(operacao)) {
            return a - b;
        } else if ("multiplicacao".equalsIgnoreCase(operacao)) {
            return a * b;
        } else if ("divisao".equalsIgnoreCase(operacao)) {
            if (b == 0) throw new ArithmeticException("Divisão por zero!");
            return a / b;
        } else {
            throw new IllegalArgumentException("Operação inválida!");
        }
    }
}

// Teste
public class MainAntipattern {
    public static void main(String[] args) {
        CalculadoraAntipattern calc = new CalculadoraAntipattern();

        System.out.println("Soma: " + calc.executarOperacao("soma", 10, 5));
        System.out.println("Subtração: " + calc.executarOperacao("subtracao", 10, 5));
        System.out.println("Multiplicação: " + calc.executarOperacao("multiplicacao", 10, 5));
        System.out.println("Divisão: " + calc.executarOperacao("divisao", 10, 5));
    }
}

