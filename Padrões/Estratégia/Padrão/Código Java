// Strategy (Interface)
interface OperacaoStrategy {
    int executar(int a, int b);
}

// Concrete Strategies
class Soma implements OperacaoStrategy {
    @Override
    public int executar(int a, int b) {
        return a + b;
    }
}

class Subtracao implements OperacaoStrategy {
    @Override
    public int executar(int a, int b) {
        return a - b;
    }
}

class Multiplicacao implements OperacaoStrategy {
    @Override
    public int executar(int a, int b) {
        return a * b;
    }
}

class Divisao implements OperacaoStrategy {
    @Override
    public int executar(int a, int b) {
        if (b == 0) throw new ArithmeticException("Divisão por zero!");
        return a / b;
    }
}

// Contexto
class Calculadora {
    private OperacaoStrategy estrategia;

    // permite trocar a estratégia em tempo de execução
    public void setEstrategia(OperacaoStrategy estrategia) {
        this.estrategia = estrategia;
    }

    public int executarOperacao(int a, int b) {
        if (estrategia == null) throw new IllegalStateException("Estratégia não definida!");
        return estrategia.executar(a, b);
    }
}

// Teste
public class Main {
    public static void main(String[] args) {
        Calculadora calc = new Calculadora();

        calc.setEstrategia(new Soma());
        System.out.println("Soma: " + calc.executarOperacao(10, 5));

        calc.setEstrategia(new Subtracao());
        System.out.println("Subtração: " + calc.executarOperacao(10, 5));

        calc.setEstrategia(new Multiplicacao());
        System.out.println("Multiplicação: " + calc.executarOperacao(10, 5));

        calc.setEstrategia(new Divisao());
        System.out.println("Divisão: " + calc.executarOperacao(10, 5));
    }
}

